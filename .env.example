# Скопіюй цей файл у .env:  cp .env.example .env
# .env не потрапляє в Git (див. .gitignore)

POSTGRES_USER=tripto
POSTGRES_PASSWORD=tripto
POSTGRES_DB=tripto

# Порти на твоєму комп'ютері. Якщо 5432 зайнятий локальним Postgres — постав 5433
DB_PORT=5432
API_PORT=3000

# Для команд Prisma, запущених НЕ в контейнері (з твого комп'ютера).
# Тут хост — localhost, бо ти звертаєшся ззовні Docker.
DATABASE_URL=postgresql://tripto:tripto@localhost:5432/tripto
