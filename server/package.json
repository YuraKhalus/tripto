{
  "name": "tripto-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tripto API — Express + Prisma + PostgreSQL",
  "scripts": {
    "dev": "nodemon --legacy-watch --ext js,json,yaml src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio --port 5555 --browser none"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "csv-stringify": "^6.9.0",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
