// Схема бази даних Tripto.
// Після кожної зміни:  docker compose exec api npx prisma migrate dev --name <що_змінили>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

